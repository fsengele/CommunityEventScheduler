
@model CommunityEventScheduler.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

@* Edit Event page *@
<div class="container py-5 event-edit-page">

    @* Page header *@
    <div class="event-edit-hero rounded-4 p-4 p-md-5 mb-4">
        <h1 class="fw-bold mb-2">Edit Event</h1>
        <p class="mb-0">Update your event information.</p>
    </div>

    @* Edit form *@
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @* Keep the event ID *@
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-4">

                    @* Event title *@
                    <div class="col-12">
                        <label asp-for="Title" class="form-label fw-semibold">
                            Event Title
                        </label>
                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter event title" />
                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    @* Event date *@
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label fw-semibold">
                            Event Date
                        </label>
                        <input asp-for="EventDate"
                               type="date"
                               asp-format="{0:yyyy-MM-dd}"
                               class="form-control" />
                        <span asp-validation-for="EventDate"
                              class="text-danger"></span>
                    </div>

                    @* Event category *@
                    <div class="col-md-6">
                        <label asp-for="EventCategoryId"
                               class="form-label fw-semibold">
                            Event Category
                        </label>
                        <select asp-for="EventCategoryId"
                                class="form-select"
                                asp-items="ViewBag.EventCategoryId">
                            <option value="">Select a category</option>
                        </select>
                        <span asp-validation-for="EventCategoryId"
                              class="text-danger"></span>
                    </div>

                    @* Start time *@
                    <div class="col-md-6">
                        <label asp-for="StartTime" class="form-label fw-semibold">
                            Start Time
                        </label>
                        <input asp-for="StartTime"
                               type="time"
                               class="form-control" />
                        <span asp-validation-for="StartTime"
                              class="text-danger"></span>
                    </div>

                    @* End time *@
                    <div class="col-md-6">
                        <label asp-for="EndTime" class="form-label fw-semibold">
                            End Time
                        </label>
                        <input asp-for="EndTime"
                               type="time"
                               class="form-control" />
                        <span asp-validation-for="EndTime"
                              class="text-danger"></span>
                    </div>

                    @* Event location *@
                    <div class="col-12">
                        <label asp-for="LocationId"
                               class="form-label fw-semibold">
                            Event Location
                        </label>
                        <select asp-for="LocationId"
                                class="form-select"
                                asp-items="ViewBag.LocationId">
                            <option value="">Select a location</option>
                        </select>
                        <span asp-validation-for="LocationId"
                              class="text-danger"></span>
                    </div>

                    @* Organizer *@
                    <div class="col-12">
                        <label asp-for="Organizer" class="form-label fw-semibold">
                            Organizer
                        </label>
                        <input asp-for="Organizer"
                               class="form-control"
                               placeholder="Enter organizer name" />
                        <span asp-validation-for="Organizer"
                              class="text-danger"></span>
                    </div>

                    @* Description *@
                    <div class="col-12">
                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Event Description
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe your event"></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                </div>

                @* Form buttons *@
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <button type="submit"
                            class="btn event-save-btn px-4 py-2">
                        Save Changes
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary px-4 py-2">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
