
@model IEnumerable<CommunityEventScheduler.Models.Event>

@{
    ViewData["Title"] = "Explore Events";
}

@* Explore Events - Community Event Scheduler *@

<section class="events-page">

    @* Page introduction *@
    <div class="events-hero">

        <p class="events-eyebrow">
            DISCOVER • CONNECT • CELEBRATE
        </p>

        <h1>Explore Community Events</h1>

        <p class="events-hero-description">
            Discover celebrations, gatherings, and special
            moments across Washington's Congolese community.
        </p>

        <a asp-action="Create" class="btn events-create-btn">
            + Create Event
        </a>

    </div>

    @* Events section *@
    <div class="events-content">

        <div class="events-section-heading">

            <div>
                <p class="events-section-label">
                    COMMUNITY CALENDAR
                </p>

                <h2>Discover Our Events</h2>

                <p>
                    Find meaningful moments and connect
                    with your community.
                </p>
            </div>

        </div>

        @* Display events from the database *@
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">

                        <article class="event-card">

                            @* Category and date *@
                            <div class="event-card-top">

                                <span class="event-category">
                                    @(item.EventCategory != null
                                        ? item.EventCategory.Name
                                        : "Community Event")
                                </span>

                                <span class="event-date">
                                    @item.EventDate.ToString("MMM dd, yyyy")
                                </span>

                            </div>

                            @* Event information *@
                            <div class="event-card-body">

                                <h3 class="event-card-title">
                                    @item.Title
                                </h3>

                                <p class="event-card-description">
                                    @item.Description
                                </p>

                                <div class="event-card-info">

                                    <div class="event-info-row">
                                        <span class="event-info-icon">
                                            📍
                                        </span>

                                        <span>
                                            @(item.Location != null
                                                ? item.Location.City + ", " + item.Location.State
                                                : "Location not available")
                                        </span>
                                    </div>

                                    <div class="event-info-row">
                                        <span class="event-info-icon">
                                            🕒
                                        </span>

                                        <span>
                                            @item.StartTime - @item.EndTime
                                        </span>
                                    </div>

                                    <div class="event-info-row">
                                        <span class="event-info-icon">
                                            👥
                                        </span>

                                        <span>
                                            @item.Organizer
                                        </span>
                                    </div>

                                </div>

                            </div>

                            @* Event actions *@
                            <div class="event-card-footer">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn event-details-btn">
                                    View Details →
                                </a>

                                <div class="event-manage-links">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id">
                                        Delete
                                    </a>

                                </div>

                            </div>

                        </article>

                    </div>
                }

            </div>
        }
        else
        {
            @* Display when there are no events *@
            <div class="events-empty">

                <h3>No Events Available Yet</h3>

                <p>
                    Community events will appear here
                    when they are created.
                </p>

                <a asp-action="Create"
                   class="btn events-create-btn">
                    Create First Event
                </a>

            </div>
        }

    </div>

</section>
