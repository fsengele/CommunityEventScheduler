
@model IEnumerable<CommunityEventScheduler.Models.Event>

@{
    ViewData["Title"] = "Explore Events";

    var cities = ViewBag.Cities as List<string>
        ?? new List<string>();

    var categories = ViewBag.Categories
        as List<CommunityEventScheduler.Models.EventCategory>
        ?? new List<CommunityEventScheduler.Models.EventCategory>();

    string? selectedCity = ViewBag.SelectedCity;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
    DateTime? selectedEventDate = ViewBag.SelectedEventDate;
}

@* Explore Events - Community Event Scheduler *@

<section class="events-page">

    @* Page introduction *@
    <div class="events-hero">

        <p class="events-eyebrow">
            DISCOVER • CONNECT • CELEBRATE
        </p>

        <h1>Explore Community Events</h1>

        <p class="events-hero-description">
            Discover celebrations, gatherings, and special
            moments across Washington's Congolese community.
        </p>

        <a asp-action="Create" class="btn events-create-btn">
            + Create Event
        </a>

    </div>

    <div class="events-content">

        @* Search and filter events *@
        <div class="card border-0 shadow-sm rounded-4 mb-5">

            <div class="card-body p-4">

                <h2 class="h4 fw-bold mb-2">
                    Find Your Next Event
                </h2>

                <p class="text-muted mb-4">
                    Search community events by city,
                    category, or date.
                </p>

                <form asp-controller="Events"
                      asp-action="Index"
                      method="get">

                    <div class="row g-3 align-items-end">

                        @* City filter *@
                        <div class="col-12 col-md-6 col-lg-3">

                            <label for="city"
                                   class="form-label fw-semibold">
                                City
                            </label>

                            <select id="city"
                                    name="city"
                                    class="form-select">

                                <option value="">
                                    All Cities
                                </option>

                                @foreach (var city in cities)
                                {
                                    if (city == selectedCity)
                                    {
                                        <option value="@city" selected>
                                            @city
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@city">
                                            @city
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        @* Category filter *@
                        <div class="col-12 col-md-6 col-lg-3">

                            <label for="categoryId"
                                   class="form-label fw-semibold">
                                Category
                            </label>

                            <select id="categoryId"
                                    name="categoryId"
                                    class="form-select">

                                <option value="">
                                    All Categories
                                </option>

                                @foreach (var category in categories)
                                {
                                    if (category.Id == selectedCategoryId)
                                    {
                                        <option value="@category.Id" selected>
                                            @category.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        @* Date filter *@
                        <div class="col-12 col-md-6 col-lg-3">

                            <label for="eventDate"
                                   class="form-label fw-semibold">
                                Event Date
                            </label>

                            <input type="date"
                                   id="eventDate"
                                   name="eventDate"
                                   class="form-control"
                                   value="@(selectedEventDate?.ToString("yyyy-MM-dd"))" />

                        </div>

                        @* Search button *@
                        <div class="col-12 col-md-6 col-lg-3">

                            <div class="d-flex gap-2">

                                <button type="submit"
                                        class="btn btn-primary flex-grow-1">
                                    Search
                                </button>

                                <a asp-controller="Events"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary">
                                    Reset
                                </a>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        @* Events section *@
        <div class="events-section-heading">

            <p class="events-section-label">
                COMMUNITY CALENDAR
            </p>

            <h2>Discover Our Events</h2>

            <p>
                Find meaningful moments and connect
                with your community.
            </p>

        </div>

        @* Display matching events *@
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">

                        <article class="event-card">

                            @* Category and date *@
                            <div class="event-card-top">

                                <span class="event-category">
                                    @(item.EventCategory != null
                                        ? item.EventCategory.Name
                                        : "Community Event")
                                </span>

                                <span class="event-date">
                                    @item.EventDate.ToString("MMM dd, yyyy")
                                </span>

                            </div>

                            @* Event information *@
                            <div class="event-card-body">

                                <h3 class="event-card-title">
                                    @item.Title
                                </h3>

                                <p class="event-card-description">
                                    @item.Description
                                </p>

                                <div class="event-card-info">

                                    <div class="event-info-row">
                                        <span class="event-info-icon">
                                            📍
                                        </span>

                                        <span>
                                            @(item.Location != null
                                                ? item.Location.City + ", " + item.Location.State
                                                : "Location not available")
                                        </span>
                                    </div>

                                    <div class="event-info-row">
                                        <span class="event-info-icon">
                                            🕒
                                        </span>

                                        <span>
                                            @item.StartTime - @item.EndTime
                                        </span>
                                    </div>

                                    <div class="event-info-row">
                                        <span class="event-info-icon">
                                            👥
                                        </span>

                                        <span>
                                            @item.Organizer
                                        </span>
                                    </div>

                                </div>

                            </div>

                            @* Event actions *@
                            <div class="event-card-footer">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn event-details-btn">
                                    View Details →
                                </a>

                                <div class="event-manage-links">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id">
                                        Delete
                                    </a>

                                </div>

                            </div>

                        </article>

                    </div>
                }

            </div>
        }
        else
        {
            @* No matching events *@
            <div class="events-empty">

                <h3>No Events Found</h3>

                <p>
                    No events match your search.
                    Try another city, category, or date.
                </p>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-primary">
                    Show All Events
                </a>

            </div>
        }

    </div>

</section>
